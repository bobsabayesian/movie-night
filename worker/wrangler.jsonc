{
  "name": "scene-sync",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "LobbyDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyDO"] }],
  "r2_buckets": [{ "binding": "LEDGER", "bucket_name": "project-files" }],
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash",
    // Zero Trust: e.g. "yourteam.cloudflareaccess.com" and the Access app's AUD tag.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    // Local dev only: skip Access JWT verification. Never set in production.
    "DEV_ADMIN": "0"
  }
  // Secret: `wrangler secret put GEMINI_API_KEY` (local: worker/.dev.vars)
}
